###################################################################
# Backup Otomatis MikroTik ke Gmail
###################################################################
# PERSIAPAN:
#
# 1. Aktifkan Verifikasi 2 Langkah pada akun Google Anda:
#    https://myaccount.google.com/security
#
# 2. Setelah Verifikasi 2 Langkah aktif, buat Kata Sandi Aplikasi:
#    https://myaccount.google.com/apppasswords
#
# 3. Google akan memberikan Kata Sandi Aplikasi (App Password).
#    Kata sandi tersebut akan digunakan pada parameter "password"
#    di konfigurasi MikroTik.
#
# PENTING:
# Password yang digunakan BUKAN password login Gmail Anda,
# melainkan Kata Sandi Aplikasi (App Password) yang dibuat
# pada langkah nomor 2.
#
# PERHATIAN:
# Sebelum melakukan copy paste konfigurasi ini, ubah terlebih
# dahulu bagian berikut:
#
# - isi_dengan_email_gmail_anda
# - isi_dengan_kata_sandi_aplikasi_gmail
# - isi_dengan_nama_pengirim_backup
# - sesuaikan_interval_backup
#
# Contoh interval:
# - 1d  = setiap 1 hari
# - 7d  = setiap 7 hari
# - 12h = setiap 12 jam
# - 30m = setiap 30 menit
#
# Author  : DevHunter Security
# Website : devhuntersecurity.github.io
###################################################################

###################################################################
# Konfigurasi SMTP Gmail
###################################################################

/tool e-mail
set server="smtp.gmail.com" \
    port=587 \
    tls=starttls \
    user="isi_dengan_email_gmail_anda" \
    password="isi_dengan_kata_sandi_aplikasi_gmail" \
    from="isi_dengan_nama_pengirim_backup"

###################################################################
# Hapus Scheduler Lama (Jika Ada)
###################################################################

/system scheduler
remove [find name=BACKUP-TO-EMAIL]

###################################################################
# Buat Scheduler Backup Otomatis
###################################################################

/system scheduler
add name=BACKUP-TO-EMAIL \
    interval=sesuaikan_interval_backup \
    start-time=startup \
    policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon \
    comment="Backup Otomatis ke Gmail" \
    on-event="#=========================================================
# Auto Backup MikroTik ke Gmail
#=========================================================
:global date [/system clock get date]
:global d [:pick \$date 4 6]
:global m [:pick \$date 0 3]
:global y [:pick \$date 7 11]

:log warning \"-> Memulai Backup Router\"

:global backupfilersc ([/system identity get name] . \"-\" . \$m . \"-\" . \$d . \"-\" . \$y)

/export file=\$backupfilersc

:delay 20s

:log warning \"-> Mengirim Backup ke Gmail\"

/tool e-mail send \
to=\"isi_dengan_email_gmail_anda\" \
subject=([/system identity get name] . \" - Backup Konfigurasi\") \
from=\"isi_dengan_nama_pengirim_backup\" \
file=(\$backupfilersc . \".rsc\")

:delay 20s

:log warning \"-> Menghapus File Backup Lokal\"

/file remove (\$backupfilersc . \".rsc\")

:delay 5s

:log warning \"-> Backup Berhasil Dikirim ke Gmail\"
"

###################################################################
# Informasi Tambahan
###################################################################
# Backup yang dikirim berupa file .RSC (hasil export konfigurasi).
#
# Untuk melakukan restore:
#
# /import file-name=nama_file_backup.rsc
#
# Disarankan melakukan pengujian pengiriman email terlebih dahulu:
#
# /tool e-mail send \
# to=\"emailanda@gmail.com\" \
# subject=\"Tes Email MikroTik\" \
# body=\"Tes pengiriman Email MikroTik berhasil\"
#
# Pastikan DNS RouterOS berfungsi dan router memiliki akses
# internet sebelum menggunakan fitur Backup Otomatis ini.
###################################################################
