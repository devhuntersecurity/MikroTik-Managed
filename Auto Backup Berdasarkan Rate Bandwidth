# Fungsi script ini adalah ketika isp utama intermittent maka, client akan otomatis backup
# Script ini hanya mengacu pada rate bandwidth saja, tidak mengacu pada ping
# Script ini hanya kompatibel dengan RouterOS 7.20.X saja
# Dibagian ip route sesuaikan dengan ip gateway isp backup anda
======================================================================================================
/routing table
add disabled=no fib name=BACKUP

/routing rule
add action=lookup comment=backup disabled=yes src-address=10.0.0.0/8 table=main
add action=lookup comment=backup disabled=yes src-address=192.168.0.0/16 table=main
add action=lookup comment=backup disabled=yes src-address=172.16.0.0/12 table=main

/ip route
add comment="ISP BACKUP" disabled=no dst-address=0.0.0.0/0 gateway=(sesuaikan ipnya) routing-table=BACKUP suppress-hw-offload=no

======================================================================================================
# Sebelum copy paste sesuaikan dulu nama interfacenya, dan batas minimal bandwidthnya
# Kemudian copy paste di scheduler dan tentukan waktunya
======================================================================================================
# Threshold RX 75 Mbps (75.000.000 bps)
:local threshold 75000000

# Nama interface
:local ifaceName "(isikan nama interface WAN utama)"

# Cari ID interface
:local ifaceId [/interface find where name=$ifaceName]

# Jika interface tidak ditemukan, keluar
:if ($ifaceId = "") do={
    :log error ("Interface '" . $ifaceName . "' tidak ditemukan!")
    :return
}

# Ambil RX via monitor-traffic
/interface monitor-traffic $ifaceId once do={ 
    :local rx $"rx-bits-per-second"

    # Cari routing rule dengan comment=backup
    :local backupRules [/routing rule find where comment="backup"]

    # Jika RX < threshold ? enable backup rules dan log custom
    :if ($rx < $threshold) do={
        :if ([:len $backupRules] > 0) do={
            /routing rule enable $backupRules
            :log warning ("Traffic utama rendah (" . $rx . " bps), tindakan BACKUP ke ISP-Backup dilakukan")
        } else={
            :log warning ("Traffic utama rendah (" . $rx . " bps), tetapi tidak ada routing rule backup ditemukan!")
        }
    } else={
        :log info ("Traffic utama tinggi normal (" . $rx . " bps), tidak ada tindakan tetap pada ISP-Utama")
    }
}
