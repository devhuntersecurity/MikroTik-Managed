# =========================================================================================
# Id-Guard DNS by Dev'Hunter Security
# =========================================================================================
#
# Fungsi:
# - Redirect seluruh trafik DNS (TCP/UDP 53) dari jaringan lokal ke Id-Guard DNS.
# - Automatic Failover ke DNS Secondary menggunakan Netwatch.
# - Automatic Recovery ke DNS Primary.
# - Mode sinkronisasi database DNS menggunakan Scheduler.
# - Perlindungan Anti Open Resolver dari interface WAN/VPN.
#
# Persyaratan:
# - MikroTik RouterOS v7.21 atau lebih baru.
# - DNS Primary harus dapat dijangkau melalui VPN Id-Guard DNS.
# - Ganti Gateway VPN, Interface WAN, dan Interface VPN sebelum import.
# - Pastikan trafik internet VPN telah melalui NAT (masquerade/srcnat).
#
# =========================================================================================

:local PrimaryDNS "103.157.116.69"
:local SecondaryDNS "103.112.162.222"
:local VPNGateway "{Masukkan IP Gateway VPN}"
:local WANInterface "{Masukkan nama interface WAN anda}"
:local VPNInterface "{Masukkan nama interface VPN anda}"

/ip firewall address-list
add address=10.0.0.0/8 list=LOCAL-ONLY comment="RFC1918"
add address=172.16.0.0/12 list=LOCAL-ONLY comment="RFC1918"
add address=192.168.0.0/16 list=LOCAL-ONLY comment="RFC1918"

/ip route
add dst-address=$PrimaryDNS gateway=$VPNGateway check-gateway=ping comment="IdGuard DNS Primary"

/ip firewall nat
add chain=dstnat action=dst-nat protocol=tcp dst-port=53 src-address-list=LOCAL-ONLY comment="Mode-Primary" to-addresses=$PrimaryDNS to-ports=53
add chain=dstnat action=dst-nat protocol=udp dst-port=53 src-address-list=LOCAL-ONLY comment="Mode-Primary" to-addresses=$PrimaryDNS to-ports=53
add chain=dstnat action=dst-nat protocol=tcp dst-port=53 src-address-list=LOCAL-ONLY comment="Mode-Secondary" disabled=yes to-addresses=$SecondaryDNS to-ports=53
add chain=dstnat action=dst-nat protocol=udp dst-port=53 src-address-list=LOCAL-ONLY comment="Mode-Secondary" disabled=yes to-addresses=$SecondaryDNS to-ports=53

/tool netwatch
add host=$PrimaryDNS type=icmp interval=10s thr-loss-percent=50% comment="IdGuard-DNS" \
up-script="/ip firewall nat enable [find comment=\"Mode-Primary\"];/ip firewall nat disable [find comment=\"Mode-Secondary\"];/ip dns cache flush" \
down-script="/ip firewall nat disable [find comment=\"Mode-Primary\"];/ip firewall nat enable [find comment=\"Mode-Secondary\"];/ip dns cache flush"

/system scheduler
add name="Disable Netwatch Sync" start-time=01:29:00 interval=1d policy=read,write,test on-event="/tool netwatch disable [find comment=\"IdGuard-DNS\"]"
add name="Sync Mode Secondary" start-time=01:30:00 interval=1d policy=read,write,test on-event="/ip firewall nat enable [find comment=\"Mode-Secondary\"];/ip firewall nat disable [find comment=\"Mode-Primary\"];/ip dns cache flush"
add name="Restore Primary" start-time=02:00:00 interval=1d policy=read,write,test on-event="/ip firewall nat enable [find comment=\"Mode-Primary\"];/ip firewall nat disable [find comment=\"Mode-Secondary\"];/ip dns cache flush;/tool netwatch enable [find comment=\"IdGuard-DNS\"]"

/interface list
:do { add name=WAN-PROTECT } on-error={}

/interface list member
:if ([:len [find where interface=$WANInterface and list="WAN-PROTECT"]]=0) do={add interface=$WANInterface list=WAN-PROTECT}
:if ([:len [find where interface=$VPNInterface and list="WAN-PROTECT"]]=0) do={add interface=$VPNInterface list=WAN-PROTECT}

/ip firewall filter
add chain=input action=drop connection-state=new protocol=tcp dst-port=53,5353,853 in-interface-list=WAN-PROTECT comment="Block Open Recursive DNS TCP"
add chain=input action=drop connection-state=new protocol=udp dst-port=53,5353,853 in-interface-list=WAN-PROTECT comment="Block Open Recursive DNS UDP"

# END CONFIG
